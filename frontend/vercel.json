{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    { "source": "/((?!apps/).*)", "destination": "/apps/vault/$1", "permanent": false }
  ],
  "rewrites": [
    { "source": "/apps/vault", "destination": "/apps/vault/index.html" },
    { "source": "/apps/vault/(.*)", "destination": "/apps/vault/index.html" }
  ]
}
