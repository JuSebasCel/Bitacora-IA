# Copia este archivo a .env.local (ya está en .gitignore) y completa los valores
# reales del proyecto de Supabase (Project Settings -> API en supabase.com).
#
# La anon key es pública por diseño (viaja en el bundle del navegador,
# protegida por las políticas de RLS de la base de datos), pero de todas
# formas nunca se commitea un archivo con valores reales.

VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key
